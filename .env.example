# Copy this file to .env and fill in your keys.

# OpenAI (used for dense embeddings + chat LLM)
OPENAI_API_KEY=sk-...

# Z.ai GLM-5.3-Flash (used for image OCR, scanned PDFs, and video analysis)
# Get one at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=...
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# GLM_MODEL=glm-5.3-flash          # or glm-5.3-flashx (~200 tok/s)
# GLM_REASONING_EFFORT=low         # low | high | max
# GLM_MAX_TOKENS=8192
# GLM_VIDEO_MAX_UPLOAD_MB=20       # videos are sent base64 (x1.33 size)

# --- Qdrant (vector database) ---
# Pick ONE of the following:
#
#   1. LOCAL EMBEDDED MODE (default, zero setup)
#      Leave QDRANT_URL unset and Qdrant will run as an in-process
#      embedded DB writing to ./qdrant_storage/
#
#   2. DOCKER / REMOTE / CLOUD MODE
#      Set QDRANT_URL to the running server's URL.
#      For Qdrant Cloud, also set QDRANT_API_KEY.
#
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional override for the embedded storage path
# QDRANT_PATH=./qdrant_storage

# Optional override for the collection name
# QDRANT_COLLECTION=adaptive_rag

# --- Models (all optional — sensible defaults are baked in) ---

# Dense embedding model (must match DENSE_SIZE)
# DENSE_MODEL=text-embedding-3-small
# DENSE_SIZE=1536

# Sparse embedding model (BM25 via FastEmbed)
# SPARSE_MODEL=Qdrant/bm25

# Chunking
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=200

# --- Retrieval & reranking ---

# How many candidates to fetch from Qdrant before reranking
# RETRIEVAL_PREFETCH_K=25

# Final number of chunks passed to the LLM after reranking
# RERANK_TOP_K=5

# FlashRank model. Lightweight options (size · quality):
#   ms-marco-TinyBERT-L-2-v2          (~4 MB, fastest)
#   ms-marco-MiniLM-L-12-v2           (~34 MB, balanced)  ← default
#   ms-marco-MultiBERT-L-12           (~150 MB, multilingual)
#   rank-T5-flan                      (~110 MB, best quality)
# RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# --- LLM (used by the chat synthesis layer) ---

# GPT-6 Luna with reasoning effort high (standard mode).
# LLM_MODEL=gpt-6-luna
# NOTE: temperature is omitted from the request automatically while
# reasoning effort != none (reasoning models reject it with a 400).
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096

# Reasoning effort: "none" / "low" / "medium" / "high" / "xhigh" / "max"
# (model-dependent). "off" omits the reasoning parameter — set it when
# swapping LLM_MODEL to a model outside the gpt-6/gpt-5.6 families (e.g.
# gpt-4.1-mini), which rejects it with a 400.
# LLM_REASONING_EFFORT=high

# --- Adaptive router (Phase 5) ---
# Same efficient model as the pipeline, at effort none for latency.
# ROUTER_MODEL=gpt-6-luna
# ROUTER_REASONING_EFFORT=none
# ROUTER_TEMPERATURE=0.0

# NL -> SQL translation runs on the same GPT-6 Luna at effort high.
# SQL_MODEL=gpt-6-luna
# SQL_REASONING_EFFORT=high

# --- Postgres (SQL tool, Phase 5) ---
# Leave SQL_DATABASE_URL unset to disable the SQL strategy entirely
# (router will only pick from no_retrieval / vector_only / clarify).
#
# For the bundled docker-compose Postgres, the seed script creates a
# read-only role; point the app at it. NOTE: the bundled compose binds
# Postgres to host port 5433 (not 5432) to avoid colliding with a
# host-installed Postgres.
# SQL_DATABASE_URL=postgresql+psycopg://adaptive_rag_ro:adaptive_rag_ro@localhost:5433/adaptive_rag
#
# For Neon / RDS / managed Postgres just paste the connection string here.
# On managed Postgres (Neon, RDS, etc.) the seed script will skip creating
# the read-only role if it lacks privileges. The app's built-in SQL guards
# (statement allowlist, forbidden-keyword regex, LIMIT injection) still
# enforce read-only behaviour at the application layer.
# SQL_DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/db?sslmode=require
#
# Optional Neon MCP server API key (only needed if using the Neon MCP).
# NEON_API_KEY=napi_...

# Per-query safety limits.
# SQL_QUERY_TIMEOUT_SEC=5
# SQL_ROW_LIMIT=200

# --- Langfuse (Phase 6: observability + cost tracking) ---
# Sign up free at https://cloud.langfuse.com (50k events/mo on free tier).
# Create a project -> Settings -> API Keys, then paste both keys here.
# Leave all three blank to disable tracing entirely; the app still works.
#
# Regions: EU (default), US, JP, or self-hosted.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Hugging Face Spaces (optional deployment) ---
# When deploying to HF Spaces, set these secrets in the Space Settings UI:
#   - OPENAI_API_KEY (required)
#   - ZAI_API_KEY     (optional, only if demoing OCR/video)
#   - SQL_DATABASE_URL (optional, use Neon for persistent SQL)
#
# Leave QDRANT_URL unset to use embedded Qdrant (vectors are lost on restart
# but re-ingesting is cheap). For persistent vectors, use Qdrant Cloud free
# tier and set QDRANT_URL + QDRANT_API_KEY.
#
# The Dockerfile pre-downloads Docling and FlashRank models so cold starts
# are fast. First build may take 5-10 minutes as models bake into the image.
